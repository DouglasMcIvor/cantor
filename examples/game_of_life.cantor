-- Conway's Game of Life — the first demo of the Image event-loop Output
-- convention (docs/design-decisions.md §6). Every Event (the browser's
-- requestAnimationFrame loop feeds an empty Char* Tick) advances the grid
-- one generation and renders it as a bitmap.

Grid = Bool*
Image = Nat * Nat * Unsigned32*

width : -> Nat
width() = 30

height : -> Nat
height() = 30

-- Whether (x, y) is alive in `grid`. The board is a torus: `count_neighbors`
-- only ever calls this with a coordinate at most one step outside [0,
-- width()) / [0, height()) (the Moore neighborhood is +-1), so a single
-- conditional wrap is enough to send an off-the-left edge back to the
-- right edge and vice versa — TODO: this doesn't generalize to a caller
-- passing an arbitrarily far out-of-range coordinate (the `rem`-based
-- Euclidean wrap this replaced would, but `rem` on a plain `Int` doesn't
-- codegen yet — see docs/wrapping-and-quotient-sets-plan.md's
-- `cantor_bigint_rem` gap — and `cell` mixing `Grid` with `Int` params
-- rules out the Kind::Int64 whole-function promotion that would otherwise
-- make `rem` usable here). The idx bounds check below is still there as
-- the proof-carrying guard on `grid[idx]` itself — the compiler can't
-- statically relate `len(grid)` to `width() * height()`, so it stays a
-- runtime check rather than a silently assumed fact.
cell : Grid * Int * Int -> Bool
cell(grid, x, y) {
    wrapped_x : Int = if x < 0 then x + width() else if x >= width() then x - width() else x
    wrapped_y : Int = if y < 0 then y + height() else if y >= height() then y - height() else y
    idx : Int = wrapped_y * width() + wrapped_x
    (
        if idx < 0 or idx >= len(grid) then
            false
        else
            grid[idx]
    )
}

count_neighbors : Grid * Int * Int -> Nat
count_neighbors(grid, x, y) = (
    (if cell(grid, x - 1, y - 1) then 1 else 0)
    + (if cell(grid, x, y - 1) then 1 else 0)
    + (if cell(grid, x + 1, y - 1) then 1 else 0)
    + (if cell(grid, x - 1, y) then 1 else 0)
    + (if cell(grid, x + 1, y) then 1 else 0)
    + (if cell(grid, x - 1, y + 1) then 1 else 0)
    + (if cell(grid, x, y + 1) then 1 else 0)
    + (if cell(grid, x + 1, y + 1) then 1 else 0)
)

-- The standard Game of Life rule: a live cell survives with 2 or 3 live
-- neighbors, a dead cell is born with exactly 3.
next_alive : Bool * Nat -> Bool
next_alive(alive, n) = (
    if alive then n == 2 or n == 3 else n == 3
)

next_generation : Grid -> Grid
next_generation(grid) {
    mut result : Bool* = []
    mut y : Nat = 0
    while y < height() {
        mut x : Nat = 0
        while x < width() {
            n : Nat = count_neighbors(grid, x, y)
            alive : Bool = cell(grid, x, y)
            result := result ++ [next_alive(alive, n)]
            x := x + 1
        }
        y := y + 1
    }
    result
}

-- Black for a dead cell, white for a live one — packed 0xRRGGBBAA per pixel
-- (docs/design-decisions.md §6's Image convention).
render : Grid -> Unsigned32*
render(grid) {
    mut pixels : Unsigned32* = []
    mut i : Nat = 0
    while i < len(grid) {
        color : Unsigned32 = if grid[i] then unsigned32(4294967295) else unsigned32(255)
        pixels := pixels ++ [color]
        i := i + 1
    }
    pixels
}

-- A glider in the top-left corner, headed toward the bottom-right — and,
-- thanks to the torus wrap in `cell`, back around to the top-left again.
seed_grid : -> Grid
seed_grid() {
    mut result : Bool* = []
    mut y : Nat = 0
    while y < height() {
        mut x : Nat = 0
        while x < width() {
            alive : Bool = (
                (x == 1 and y == 0)
                or (x == 2 and y == 1)
                or (x == 0 and y == 2)
                or (x == 1 and y == 2)
                or (x == 2 and y == 2)
            )
            result := result ++ [alive]
            x := x + 1
        }
        y := y + 1
    }
    result
}

main : Char* * Grid -> Image * Grid
main(event, grid) {
    next : Grid = next_generation(grid)
    pixels : Unsigned32* = render(next)
    ((width(), height(), pixels), next)
}

main : -> Grid
main() = seed_grid()
