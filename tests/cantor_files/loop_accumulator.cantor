-- Regression fixture for the loop-accumulator lowering
-- (src/codegen/accumulator.rs): `v := v ++ [x]` inside a loop compiles to an
-- O(1) builder push instead of copying the whole vector each iteration.
--
-- Covers the flat case, the nested case (the accumulate is in the inner loop
-- but the declaration is outside both), a non-empty starting vector (the
-- builder must be seeded from it), a Bool accumulator, and — crucially — a
-- loop that *reads* its accumulator, which must NOT be optimised and must
-- still produce the ordinary answer.
build_flat : Nat -> Int*
build_flat(n) {
    mut v : Int* = []
    mut i : Nat = 0
    while i < n {
        v := v ++ [i * 2]
        i := i + 1
    }
    v
}

-- Nested: the accumulate is in the inner loop, the declaration outside both.
build_nested : Nat -> Int*
build_nested(n) {
    mut v : Int* = []
    mut y : Nat = 0
    while y < n {
        mut x : Nat = 0
        while x < n {
            v := v ++ [y * 10 + x]
            x := x + 1
        }
        y := y + 1
    }
    v
}

-- Starts non-empty: the builder must be seeded from the existing elements.
build_seeded : Nat -> Int*
build_seeded(n) {
    mut v : Int* = [7, 8]
    mut i : Nat = 0
    while i < n {
        v := v ++ [i]
        i := i + 1
    }
    v
}

-- Reads the accumulator inside the loop, so must NOT be optimised.
build_reads : Nat -> Int*
build_reads(n) {
    mut v : Int* = [1]
    mut i : Nat = 0
    while i < n {
        v := v ++ [len(v)]
        i := i + 1
    }
    v
}

-- Bool accumulator.
build_bools : Nat -> Bool*
build_bools(n) {
    mut v : Bool* = []
    mut i : Nat = 0
    while i < n {
        v := v ++ [i * 2 < n]
        i := i + 1
    }
    v
}

-- Position-weighted checksum: catches a wrong length, a wrong element and
-- a wrong order, unlike a plain sum.
checksum : Int* -> Int
checksum(v) {
    mut acc : Int = 0
    mut i : Nat = 0
    while i < len(v) {
        acc := acc + (v[i] + 1) * (i + 1)
        i := i + 1
    }
    acc
}

count_true : Bool* -> Int
count_true(v) {
    mut acc : Int = 0
    mut i : Nat = 0
    while i < len(v) {
        acc := if v[i] then acc + (i + 1) else acc
        i := i + 1
    }
    acc
}

main : -> Int
main() = (
    checksum(build_flat(5))
    + checksum(build_nested(3)) * 1000
    + checksum(build_seeded(2)) * 1000000
    + checksum(build_reads(3)) * 1000000000
    + count_true(build_bools(4))
)
